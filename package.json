{
  "name": "buse-tp-platform",
  "version": "1.0.0",
  "description": "Teaching Practice Management Platform for BUSE",
  "main": "index.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev": "concurrently \"npm:dev-backend\" \"npm:dev-frontend\"",
    "dev-backend": "cd backend && npm run dev",
    "dev-frontend": "cd frontend && npm start",
    "build": "npm run build-frontend",
    "build-frontend": "npm run build --workspace=buse-tp-frontend",
    "test": "npm run test-backend",
    "test-backend": "npm run test --workspace=buse-tp-backend"
  },
  "devDependencies": {
    "concurrently": "^7.6.0"
  },
  "keywords": [
    "BUSE",
    "Teaching Practice",
    "Education Management",
    "React",
    "Node.js"
  ],
  "author": "Evade Dube",
  "license": "PROPRIETARY"
}
